# copy to .env and fill in real values, .env is gitignored

# DB_PATH overrides the default sqlite path (Code/data/career_compass.db)
# DB_PATH=C:/path/to/career_compass.db

# Adzuna job API, get keys from https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Brave web search, leave blank to disable Tool
BRAVE_API_KEY=

# Ollama model overrides (defaults already match config.py)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LARGE_MODEL=llama2:13b
# OLLAMA_SMALL_MODEL=mistral:7b
